DATABASE_URL=postgresql://postgres:password@localhost:5432/doctor_attender

# Signs login tokens. Required, at least 32 characters. Use your own random value;
# production sets a different one in Coolify. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=local-dev-only-secret-change-me-0123456789
JWT_EXPIRES_IN=30d

# Speech-to-text provider: 'whisper' (free, open-source, default), 'sarvam' (paid) or
# 'gemini' (paid, Google; detects Tamil/Hindi/English and writes each in its own script).
# 'whisper' requires the stt-service/ sidecar to be running (see stt-service/README.md).
STT_PROVIDER=whisper
WHISPER_URL=http://localhost:8000
STT_LANGUAGE=auto

# Only used when STT_PROVIDER=sarvam:
SARVAM_API_KEY=

# AI summary provider: 'mock' (canned, default), 'kimi' (paid, Moonshot AI — OpenAI-compatible API)
# or 'gemini' (paid, Google).
SUMMARY_PROVIDER=mock
SUMMARY_LANGUAGE=English
# Only used when SUMMARY_PROVIDER=kimi. Base URL must end in /v1.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6
# Thinking mode: disabled (default, ~4s) or enabled (~45s, can exceed the 60s timeout).
KIMI_THINKING=disabled

# Only used when STT_PROVIDER and/or SUMMARY_PROVIDER = gemini. Key from Google AI Studio
# (https://aistudio.google.com/apikey). For real patients the key's project must have billing ON:
# on the free tier Google may use the requests to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Languages a patient may answer in. Gemini names one per answer, then writes it in that
# language's own script (a patient can switch language per answer). Empty = "Tamil, Hindi or English".
# Telugu is not proven yet (Telugu spoken by a Tamil speaker was heard as Tamil).
GEMINI_LANGUAGES=

AUDIO_DIR=./uploads
# Report photos (CLINIC-011). Defaults to <AUDIO_DIR>/reports.
# REPORTS_DIR=./uploads/reports
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
PORT=4000
