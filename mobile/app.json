{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.wisright.doctorattender",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "ClinicAI needs microphone access to record patient answers."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "ClinicAI needs camera access to photograph the patient's previous reports.",
          "photosPermission": "ClinicAI needs photo access to attach the patient's previous reports.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
