# Root build context (used by backend/Dockerfile, which needs both backend/ and db/).
# Keep the image lean and never ship host-built native modules or secrets.
**/node_modules
**/.env
**/npm-debug.log
.git
.gitignore

# Not part of the backend image.
mobile/
frontend/
stt-service/
docs/
# scripts/ except the clinic setup script (CLINIC-008.6), which runs in the backend container.
scripts/*
!scripts/clinic-admin.mjs
!scripts/clinic-admin-lib.js
storage/
**/uploads
*.html
*.md
docker-compose*.yml
